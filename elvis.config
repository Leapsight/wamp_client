[
 {
   dirs, ["src", "test"],
   filter, "*.erl",
   ruleset, erl_files,
   rules, [
             %% Override default line_length rule
             {elvis_text_style, line_length, [
               {limit, 121},
               {skip_comments, false}
             ]},
             
             %% Essential style rules only
             {elvis_style, no_tabs},
             {elvis_style, macro_names, [{ignore, []}]},
             
             %% Naming conventions
             {elvis_style,
              module_naming_convention,
              [{regex, "^[a-z]([a-z0-9]*_?)*(_SUITE)?$"}, {ignore, []}]},
             {elvis_style, function_naming_convention, [{regex, "^([a-z][a-z0-9]*_?)*$"}]},
             
             %% Code organization and safety
             {elvis_style, used_ignored_variable},
             {elvis_style, invalid_dynamic_call, [
               {ignore, [awre_transport, awre_con, awre_trans_tcp]}  %% Allow specific modules that need dynamic calls
             ]}
            ]
 },
 {
   dirs, ["."],
   filter, "rebar.config",
   rules, []  %% No project rules to keep it simple
 }
].